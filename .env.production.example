APP_NAME="Forge Market"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forge_market
DB_USERNAME=forge_market
DB_PASSWORD=replace-with-a-strong-database-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=/absolute/path/to/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=forge_market

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=pk_live_replace_with_live_publishable_key
STRIPE_SECRET=sk_live_replace_with_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_live_webhook_secret
STRIPE_CURRENCY=usd

PAYSTACK_PUBLIC_KEY=pk_live_replace_with_live_public_key
PAYSTACK_SECRET_KEY=sk_live_replace_with_live_secret_key
PAYSTACK_CURRENCY=NGN
PAYSTACK_BASE_URL=https://api.paystack.co

VITE_APP_NAME="${APP_NAME}"
